local function createNewMovingPath(pos)
	if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
		game.Players.LocalPlayer.Character:PivotTo(CFrame.new(pos))
	end
	return true
end

local currentRooms = workspace:WaitForChild("CurrentRooms", 10)
local currentRoom0 = currentRooms and currentRooms:WaitForChild("0", 10)

if currentRoom0 then
	local keyHitbox = currentRoom0:WaitForChild("Assets", 10):WaitForChild("KeyObtain", 10):WaitForChild("Hitbox", 10)

	local keyTimeout = tick()
	repeat 
		local keyPrompt = currentRoom0:FindFirstChild("KeyObtain", true) and currentRoom0:FindFirstChild("KeyObtain", true):FindFirstChild("ModulePrompt")
		if keyHitbox then
			createNewMovingPath(keyHitbox.Position + Vector3.new(0, 0, 5))
		end
		if keyPrompt and keyPrompt:IsDescendantOf(workspace) then
			fireproximityprompt(keyPrompt)
		end
		task.wait(0.05)
	until game.Players.LocalPlayer.Character:FindFirstChild("Key") or (tick() - keyTimeout > 15)

	local roomExit = currentRoom0:WaitForChild("RoomExit", 10)
	local doorLooping = true

	task.spawn(function()
		while doorLooping do
			local doorPrompt = currentRoom0:FindFirstChild("UnlockPrompt", true)
			if roomExit then
				createNewMovingPath(roomExit.Position + Vector3.new(0, 0, 5))
			end
			
			if doorPrompt and doorPrompt:IsDescendantOf(workspace) then
				fireproximityprompt(doorPrompt)
			end
			task.wait(0.05)
		end
	end)

	cewcew = false
	task.wait(8)
	doorLooping = false
end

